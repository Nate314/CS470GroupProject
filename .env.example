# Copy to .env (git-ignored) and fill in. `docker compose up --build` also works
# without a .env file, using the development defaults in docker-compose.yml.
# ./run.ps1 and ./run.sh add the port line below themselves.

# MySQL root password. Only used inside the MySQL container (init and healthcheck).
MYSQL_ROOT_PASSWORD=change-me-root-password

# MySQL user the Python service connects as (created on the DiscordBot database at first start).
DB_USER=discordbot_app
DB_PASSWORD=change-me-app-password

# Secret the service signs its HS256 JSON Web Tokens with. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
# Optional: lifetime of the tokens the service hands out, in seconds.
# TOKEN_LIFETIME=3600
# Optional: RSA public key (PEM) for the RS256 bot login (PUT /auth/login). Nothing in this repo calls it.
# RSA_PUBLIC_KEY=

# Both required by the bot. Without either one the bot container exits with a message.
# Discord bot token from the Discord developer portal.
DISCORD_TOKEN=
# Token the bot logs in to the service with: a JWT signed with JWT_SECRET. Generate it after setting JWT_SECRET:
#   docker compose run --rm --no-deps service python -c "import jwt,os; print(jwt.encode({'DiscordUserID': '0'}, os.environ['JWT_SECRET'], 'HS256'))"
BOT_API_TOKEN=
# Optional: command prefix (default r?).
# BOT_PREFIX=

# Host port of the client. run.sh / run.ps1 rewrite it to a free port when 8080 is busy.
CLIENT_PORT=8080
